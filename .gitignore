# Environment variables
.env
.env.local
.env.*.local
# Bug fix 2026-09-13: ``.env.glm`` contains plaintext API keys and was
# previously matched by neither ``.env`` nor ``.env.*.local`` (the latter
# only catches *.local). Explicitly exclude it so a careless ``git add .``
# never commits the credentials.
.env.glm
# Also exclude other .env.* vendor profiles by name; add new profiles
# here as they are created.
.env.kimi
.env.deepseek

# Configuration with sensitive data
#
# The real config.py reads .env, so it holds no secrets itself and is imported
# by nearly every module in the project. It must be tracked: leaving it
# ignored means a fresh clone cannot import `config`, so every entry point
# fails at import time and the ignored file is invisible to `git status`.
config.py

# Per-AS prefix2as expansion caches (regenerable from data/prefix2as).
data/prefix2as/ipv6_cache/

