# =============================================================================
# BGP Tracer — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is already covered by .gitignore.
# =============================================================================

# ---------- Cloudflare Radar API (traffic data) --------------------------------
# *** REQUIRED *** — without this token the traffic detector will return
# "Missing X-Auth-Key, X-Auth-Email or Authorization headers" and every
# Cloudflare call will fail.
# Get yours at: https://radar.cloudflare.com/ → Account → API Tokens
CLOUDFLARE_API_TOKEN=

# Override only if you want to limit the view to a specific country/region.
# Must be ISO 3166-1 alpha-2 (e.g. RU, CN, US). Leave empty for worldwide.
CLOUDFLARE_RADAR_LOCATION=
# MIN0_MAX matches the Cloudflare Radar web UI and is recommended.
CLOUDFLARE_RADAR_NORMALIZATION=MIN0_MAX

# ---------- LLM (OpenAI-compatible) -------------------------------------------
OPENAI_BASE_URL=https://uni-api.cstcloud.cn/v1
OPENAI_MODEL=qwen3.5
OPENAI_API_KEY=

# ---------- Optional: Kimi / CSTCLOUD secondary LLM ---------------------------
CSTCLOUD_BASE_URL=https://api.kimi.com/coding/v1
CSTCLOUD_TOKEN=
CSTCLOUD_MODEL=kimi-for-coding

# ---------- Optional: RIPE / RDAP / Whois credentials -------------------------
RIPESTAT_TOKEN=
RIPE_DB_WHOIS_USERNAME=
RIPE_DB_WHOIS_PASSWORD=

# ---------- Optional: DeepSeek thinking chain ---------------------------------
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_THINKING_MODEL=deepseek-reasoner
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- Optional: Elasticsearch (only if you wire it up) ------------------
ES_HOST=http://10.200.23.2:9200
ES_PORT=9200
ES_USE_SSL=false
ES_VERIFY_CERTS=false
ES_USER=
ES_PASSWORD=
ES_ENABLED=false
USE_ES_FOR_CONN_FREQ=false
ES_CONN_FREQ_TIMEOUT=30.0

# ---------- Workflow Engine knobs (rarely needed) -----------------------------
WORKFLOW_ENGINE_ENABLED=true
WORKFLOW_PARALLEL_EXECUTION=true
WORKFLOW_SKIP_WHEN_NO_ANOMALIES=true
WORKFLOW_MAX_RETRIES=3
WORKFLOW_TRACE_ENABLED=true
WORKFLOW_ANALYSIS_MODE=traffic_first

REACT_MAX_ROUNDS=15
REACT_STREAMING_ENABLED=true
REACT_LLM_TEMPERATURE=0.1

QUICK_SCREENING_THRESHOLD=0.3
TRAFFIC_ANOMALY_THRESHOLD=0.2
CROSS_VALIDATION_WARNING_THRESHOLD=1
BUFFER_HOURS=2.0
MIN_TIME_RANGE_FOR_SKIP_EXPANSION=6.0

# ---------- Optional: chief_agent feature switches ----------------------------
# MITM / hijack detection. Default false. Toggle on for hijack-related events.
MITM_DETECTION_ENABLED=false
# Enable checkpoint-based resume for long-running chief_agent jobs. Default false.
CHECKPOINTING_ENABLED=false
# Emit full result as JSON to stdout (chief_agent --json-output equivalent). Default false.
JSON_OUTPUT_ENABLED=false